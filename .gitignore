# ============================================================================
# TERRAFORM
# ============================================================================

# Local .terraform directories
**/.terraform/*
.terraform/

# Terraform state files (contain sensitive data and managed remotely)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
plan.out

# Terraform variable files (may contain secrets - exclude by default)
*.tfvars
*.tfvars.json

# Exceptions: Allow example and test files (no secrets)
!terraform.tfvars.example
!test.tfvars

# Terraform CLI configuration files
.terraformrc
terraform.rc

# Crash log files
crash.log
crash.*.log

# Note: .terraform.lock.hcl SHOULD be committed to ensure consistent provider versions

