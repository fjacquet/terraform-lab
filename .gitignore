# Local .terraform directories
**/.terraform/*

# .tfstate files (contain sensitive data and managed remotely)
*.tfstate
*.tfstate.*

# .tfvars files (may contain secrets - exclude by default)
*.tfvars

# Exception: Allow test.tfvars (no secrets)
!test.tfvars

# Note: .terraform.lock.hcl should be committed to ensure consistent provider versions
**/bin/*
**/secrets/*
**/private/*
.DS_Store
convert
sonar-check.sh
.cache/
.dccache
org-token.txt
