# ANSIBLE
# ============================================================================

# Ansible retry files
*.retry

# Ansible vault password files
.vault_pass
.vault_password
vault_pass.txt

# Ansible collections and roles cache
.ansible/
collections/ansible_collections/

# Ansible logs
ansible.log

