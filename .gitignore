sonar-check.sh
verify-fixes.sh

# Archive directory (optional - uncomment if you don't want to commit archives)
# archive/

# ============================================================================
# DOCUMENTATION ARTIFACTS
# ============================================================================

# Temporary documentation files
*-COMPLETE.md
*-PLAN.md
REFACTORING-*.md
VARIABLE-CLEANUP-*.md

# ============================================================================
# CI/CD
# ============================================================================

# GitHub Actions
# .github/ - Keep this committed

# Pre-commit
# .pre-commit-config.yaml - Keep this committed

# ============================================================================
# NOTES
# ============================================================================

# Files that SHOULD be committed:
# - .terraform.lock.hcl (ensures consistent provider versions)
# - .pre-commit-config.yaml (pre-commit hooks configuration)
# - .ansible-lint (Ansible linting configuration)
# - .yamllint (YAML linting configuration)
# - terraform.tfvars.example (template for users)
# - test.tfvars (test configuration without secrets)
# - requirements.yml (Ansible dependencies)
# - pyproject.toml (Python project configuration)
