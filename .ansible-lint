---
# ============================================================================
# ANSIBLE-LINT CONFIGURATION
# Configured to focus on critical issues while suppressing cosmetic warnings
# ============================================================================

# Paths to exclude from linting
exclude_paths:
  - .cache/
  - .github/
  - .venv/
  - collections/
  - archive/
  - .ansible/
  - .scannerwork/

# Output format
parseable: true

# Enable checking of loop variable prefixes in roles
loop_var_prefix: "{role}_"

# Use default rules as baseline
use_default_rules: true

# ============================================================================
# SKIP LIST - Rules to completely ignore
# These are either not applicable or intentionally not followed
# ============================================================================

skip_list:
  # Cosmetic issues (low priority for lab environment)
  - name[casing] # Task names don't need to start with uppercase (cosmetic)
  - name[play] # Plays don't need names (cosmetic)
  - name[missing] # Tasks don't need names (cosmetic)
  - jinja[spacing] # Jinja2 spacing is cosmetic
  - key-order[task] # Task key order is cosmetic

  # Variable naming (medium priority - suppress for now)
  - var-naming[no-role-prefix] # Variables don't need role prefix in lab environment

  # Deprecated/legacy rules
  - deprecated-local-action # Legacy syntax
  - empty-string-compare # Legacy pattern
  - git-latest # Using latest is acceptable in lab
  - package-latest # Using latest is acceptable in lab

  # Meta/role rules (not critical)
  - meta-incorrect # meta/main.yml defaults are acceptable
  - meta-no-info # meta/main.yml info not critical for lab
  - meta-no-tags # Tags not critical for lab
  - role-name # Role naming is flexible

  # Handler/change detection (not critical for lab)
  - no-changed-when # Change detection not critical
  - no-handler # Handler usage is flexible

  # Other non-critical rules
  - no-loop-var-prefix # Loop var prefix not critical
  - no-same-owner # Owner handling is flexible
  - risky-file-permissions # File permissions handled separately
  - no-free-form # Free-form syntax is acceptable

# ============================================================================
# ENABLE LIST - Opt-in rules to enable
# ============================================================================

enable_list:
  - yaml # Enable YAML validation (critical)

# ============================================================================
# WARN LIST - Show as warnings instead of errors
# These issues should be fixed eventually but won't block execution
# ============================================================================

warn_list:
  - experimental # Experimental features
  - command-instead-of-shell # Prefer command over shell
  - command-instead-of-module # Prefer modules over commands
  - deprecated-command-syntax # Deprecated syntax patterns
  - inline-env-var # Environment variable usage
  - literal-compare # Literal comparisons
  - no-jinja-when # Jinja in when conditions
  - no-tabs # Tab characters
  - partial-become # Partial privilege escalation
  - playbook-extension # Playbook file extensions
  - unnamed-task # Unnamed tasks (warning only)
  - var-spacing # Variable spacing

# ============================================================================
# OFFLINE MODE
# Disable installation of requirements.yml during linting
# ============================================================================

offline: true

# ============================================================================
# FILE KIND DETECTION
# Help ansible-lint identify file types correctly
# ============================================================================

kinds:
  - tasks: "**/tasks/*.yml"
  - tasks: "**/tasks/*.yaml"
  - vars: "**/vars/*.yml"
  - vars: "**/vars/*.yaml"
  - defaults: "**/defaults/*.yml"
  - defaults: "**/defaults/*.yaml"
  - handlers: "**/handlers/*.yml"
  - handlers: "**/handlers/*.yaml"
  - meta: "**/meta/main.yml"
  - meta: "**/meta/main.yaml"
  - playbook: "**/playbooks/*.yml"
  - playbook: "**/playbooks/*.yaml"
  - playbook: "playbooks/**/*.yml"
  - playbook: "playbooks/**/*.yaml"

# ============================================================================
# NOTES
# ============================================================================

# This configuration is optimized for a lab/testing environment where:
# - Cosmetic issues are suppressed to reduce noise
# - Critical syntax and schema errors are still caught
# - Variable naming conventions are relaxed
# - Focus is on functionality over style

# To see all issues (including suppressed ones):
#   ansible-lint --show-relpath playbooks/

# To run with strict mode (no suppressions):
#   ansible-lint --strict playbooks/

# To fix auto-fixable issues:
#   ansible-lint --fix playbooks/

# ============================================================================
# CRITICAL ISSUES STILL CHECKED
# ============================================================================

# The following critical issues are NOT suppressed and will cause errors:
# - syntax-check[specific]    # Syntax errors
# - schema[meta]              # Invalid role metadata
# - schema[tasks]             # Invalid task structure
# - schema[playbook]          # Invalid playbook structure
# - jinja[invalid]            # Invalid Jinja2 syntax
# - load-failure              # File loading failures
# - parser-error              # YAML parsing errors
